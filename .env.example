# Copie este arquivo para ".env.local" e preencha os valores reais.
# Nunca commite o arquivo ".env.local" de verdade.

# --- Supabase ---
# URL e anon key: Project Settings > API, no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic (extração de dados de apólices por IA — /documents) ---
# Crie uma chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Voyage AI (embeddings do assistente RAG — /assistant) ---
# Crie uma chave em https://dashboard.voyageai.com/api-keys
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --- Stripe (cobrança da assinatura — /billing) ---
# Chave secreta: https://dashboard.stripe.com/apikeys (use a de modo teste pra desenvolver)
STRIPE_SECRET_KEY=
# Id do Price recorrente de R$49,99/mês, criado manualmente no dashboard do Stripe
# (Product catalog > Add product) — não é criado pelo código.
STRIPE_PRICE_ID=
# Assinatura do endpoint de webhook: https://dashboard.stripe.com/webhooks (produção)
# ou o valor que o `stripe listen` imprime ao rodar localmente (ver README).
STRIPE_WEBHOOK_SECRET=
# Service role key do Supabase — Project Settings > API > service_role.
# Usada pelo webhook do Stripe (src/app/api/webhooks/stripe/route.ts), pelo
# reset de senha e exclusão de conta no painel admin (src/lib/supabase/admin.ts,
# src/lib/tenants/delete-tenant.ts), sempre atrás de checagem de assinatura
# do Stripe, platform_admins ou do CRON_SECRET abaixo — nunca exposta a
# código client-side. Não confundir com a anon key acima.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo compartilhado pelos crons do projeto (ver vercel.json): exclusão
# definitiva de contas agendadas depois dos 30 dias de carência
# (src/app/api/cron/purge-tenants/route.ts) e o keepalive semanal que evita
# a pausa automática do Supabase por inatividade
# (src/app/api/cron/supabase-keepalive/route.ts). Gere um valor aleatório
# (ex: openssl rand -hex 32) e cadastre o MESMO valor como variável de
# ambiente CRON_SECRET no projeto Vercel — a própria Vercel usa esse valor
# pra autenticar a chamada automática, não precisa configurar nada além disso.
CRON_SECRET=

# --- Resend (envio de e-mail do motor de aquisição de leads — /admin/growth) ---
# Chave de API: https://resend.com/api-keys
RESEND_API_KEY=
# Endereço "de" verificado no domínio cadastrado no Resend (https://resend.com/domains).
RESEND_FROM_EMAIL=
# Segredo do endpoint de webhook (src/app/api/webhooks/resend/route.ts), pra
# validar a assinatura Svix dos eventos de entrega/abertura/bounce/complaint.
# https://resend.com/webhooks — criar um endpoint apontando pra
# https://<domínio>/api/webhooks/resend e copiar o "Signing Secret".
RESEND_WEBHOOK_SECRET=

# --- WhatsApp Business Platform / Meta Cloud API (envio via /admin/growth) ---
# Setup manual no Meta Business Manager antes de preencher (business.facebook.com):
# criar app tipo Business, adicionar produto WhatsApp, verificar a empresa,
# registrar um número, criar e aprovar um template de categoria Marketing com
# uma variável de corpo (nome sugerido: growth_outreach_v1).
# Token de acesso de longa duração do app.
WHATSAPP_ACCESS_TOKEN=
# Phone Number ID do número registrado (painel do WhatsApp no Meta Business Manager).
WHATSAPP_PHONE_NUMBER_ID=
# Nome do template aprovado (padrão usado no código: growth_outreach_v1).
WHATSAPP_TEMPLATE_NAME=growth_outreach_v1
# App Secret (Configurações do app > Básico) — valida a assinatura
# X-Hub-Signature-256 do webhook (src/app/api/webhooks/whatsapp/route.ts).
META_APP_SECRET=
# Valor à sua escolha, cadastrado junto com a URL do webhook
# (https://<domínio>/api/webhooks/whatsapp) no painel de Webhooks do app —
# usado só na checagem inicial (handshake) de que a URL é sua mesmo.
META_WEBHOOK_VERIFY_TOKEN=

# --- Sentry (monitoramento de erros em produção) ---
# DSN do projeto: https://sentry.io/settings/<org>/projects/<projeto>/keys/
# Não é segredo (vai pro bundle do cliente), mas sem ela nada é reportado.
NEXT_PUBLIC_SENTRY_DSN=

# --- Google Tag Manager (rastreamento pra campanhas pagas) ---
# Crie um container em tagmanager.google.com, copie o ID (formato GTM-XXXXXXX)
# e cole aqui. Sem essa variável, nenhum script de tag carrega — o site
# funciona normalmente. Configure o Google Ads/Meta Pixel/GA4 dentro do
# próprio GTM depois, sem precisar mexer no código. Eventos já disparados
# (ver `trackEvent(` em src/app): "signup_started", "signup_submitted",
# "email_confirmed", "first_policy_created", "first_assistant_question" (topo
# de funil) e "subscription_activated" (com value/currency — este é o de
# CONVERSÃO DE VALOR pra otimizar campanha por ROAS, não só volume de cadastro).
NEXT_PUBLIC_GTM_ID=
