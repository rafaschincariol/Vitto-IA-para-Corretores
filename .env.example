# Copie este arquivo para ".env.local" e preencha os valores reais.
# Nunca commite o arquivo ".env.local" de verdade.

# --- Supabase ---
# URL e anon key: Project Settings > API, no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic (extração de dados de apólices por IA — /documents) ---
# Crie uma chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Voyage AI (embeddings do assistente RAG — /assistant) ---
# Crie uma chave em https://dashboard.voyageai.com/api-keys
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --- Stripe (cobrança da assinatura — /billing) ---
# Chave secreta: https://dashboard.stripe.com/apikeys (use a de modo teste pra desenvolver)
STRIPE_SECRET_KEY=
# Id do Price recorrente de R$49,99/mês, criado manualmente no dashboard do Stripe
# (Product catalog > Add product) — não é criado pelo código.
STRIPE_PRICE_ID=
# Assinatura do endpoint de webhook: https://dashboard.stripe.com/webhooks (produção)
# ou o valor que o `stripe listen` imprime ao rodar localmente (ver README).
STRIPE_WEBHOOK_SECRET=
# Service role key do Supabase — Project Settings > API > service_role.
# USADA SÓ pelo webhook do Stripe (src/app/api/webhooks/stripe/route.ts),
# nunca em nenhum outro lugar do código. Não confundir com a anon key acima.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sentry (monitoramento de erros em produção) ---
# DSN do projeto: https://sentry.io/settings/<org>/projects/<projeto>/keys/
# Não é segredo (vai pro bundle do cliente), mas sem ela nada é reportado.
NEXT_PUBLIC_SENTRY_DSN=
